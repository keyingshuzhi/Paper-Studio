# 环境配置示例：复制为 .env 后按需填写
# Web / 桌面端建议在「设置 → 模型服务商」管理连接；桌面端密钥使用系统加密存储。

# ============ 模型服务商（v0.1.0） ============
# 以下变量主要用于 CLI 与旧版配置兼容。Web / 桌面端支持多服务商配置。
# auto：优先使用可达的 Ollama，否则使用 DeepSeek；也可指定 ollama / deepseek。
LLM_PROVIDER=auto

# --- DeepSeek（云端，按量计费） ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# 2026-07-24 后旧名 deepseek-chat/reasoner 停用，默认用 V4-Flash
DEEPSEEK_MODEL=deepseek-v4-flash
# 可选：deepseek-v4-pro（更贵：输入 $1.74/M，输出 $3.48/M）

# --- 其他内置云端服务商 ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# 其他 OpenAI 兼容服务可在设置页自定义 Base URL、模型和密钥环境变量。

# --- Ollama（本地，零成本） ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# ============ 其他 ============

# HTTP 请求超时（秒）
HTTP_TIMEOUT=20

# 搜索结果默认上限
DEFAULT_MAX_RESULTS=10

# 下载目录（相对项目根目录）
DOWNLOAD_DIR=downloads

# 可选：如果以后接入需要 Key 的服务（如 SerpAPI 爬 Google Scholar）
# SERPAPI_KEY=

# LLM 请求超时（秒）。Web / 桌面端设置会覆盖此值，建议本地大模型设为 180-300。
LLM_TIMEOUT=90

# 未在代码中指定时的单次最大输出 tokens。
LLM_MAX_OUTPUT_TOKENS=2048
